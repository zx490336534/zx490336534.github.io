diff --git a/src/components/workspace/composer-draft.ts b/src/components/workspace/composer-draft.ts
new file mode 100644
index 0000000..04e340e
--- /dev/null
+++ b/src/components/workspace/composer-draft.ts
@@ -0,0 +1,24 @@
+// Match the upstream standalone tool's per-tab, per-session draft keys.
+const prefix = 'next-ai-test-cases:composer:';
+const memoryDrafts = new Map<string, string>();
+
+export function readComposerDraft(id: string) {
+  if (memoryDrafts.has(id)) return { text: memoryDrafts.get(id)!, stored: false };
+  try {
+    return { text: sessionStorage.getItem(prefix + id) ?? '', stored: true };
+  } catch {
+    return { text: '', stored: false };
+  }
+}
+
+export function writeComposerDraft(id: string, text: string) {
+  try {
+    if (text) sessionStorage.setItem(prefix + id, text);
+    else sessionStorage.removeItem(prefix + id);
+    memoryDrafts.delete(id);
+    return { text, stored: true };
+  } catch {
+    memoryDrafts.set(id, text);
+    return { text, stored: false };
+  }
+}
