          "from": 350
        }
      ],
      "duration": 439
    },
    {
      "heading": "检查缺失行和数据污染",
      "mode": "ledger",
      "items": [
        [
          "最小集",
          "一正两反可重复执行"
        ],
        [
          "空行或空集",
          "明确报告，而不是误判通过"
        ],
        [
          "独立性",
          "多行互不继承可变状态"
        ]
      ],
      "foot": "只在隔离环境跑虚构样本，不使用历史登录值",
      "cues": [
        {
          "to": 45,
          "text": "最后加两种保护。",
          "file": "4-0.mp3",
          "from": 8
        },
        {
          "to": 166,
          "text": "数据源为空时要能被发现，否则没执行任何用例也可能被误读为没有失败。",
          "file": "4-1.mp3",
          "from": 47
        },
        {
          "to": 261,
          "text": "多行运行时，不要让上一行写下的状态不知不觉影响下一行。",
          "file": "4-2.mp3",
          "from": 168
        },
        {
          "to": 363,
          "text": "先用少量正反例重复执行，确认每一条都按照自己的条件判断。",
          "file": "4-3.mp3",
          "from": 263
        },
        {
          "to": 485,
          "text": "数据驱动的价值，是把相同规则守得更稳，而不是生成数量看起来更大的报表。",
