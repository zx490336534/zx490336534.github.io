        ],
        [
          "慢帧",
          "在哪几段超过预期节奏"
        ]
      ],
      "foot": "显示刷新条件不同，判断阈值要随测试设置",
      "cues": [
        {
          "to": 63,
          "text": "把帧想成不断送到屏幕的卡片。",
