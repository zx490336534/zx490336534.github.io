      "artAsset": "scene-04.webp",
      "cues": [
        {
          "to": 77,
          "text": "如果一项功能改完测试都绿，先不急着接受。",
          "file": "3-0.mp3",
          "from": 8
        },
        {
          "to": 150,
          "text": "回到三个问题：一开始到底有什么失败证据？",
          "file": "3-1.mp3",
