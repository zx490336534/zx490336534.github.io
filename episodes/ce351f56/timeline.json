    {
      "heading": "先说清楚字段规则再做比较",
      "mode": "trace",
      "items": [
        [
          "标题",
          "文本且不能是约定中的空白"
        ],
        [
          "数量",
          "是整数且在纸面规定范围"
        ],
        [
          "状态",
          "验证通过才继续处理"
