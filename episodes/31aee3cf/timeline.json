        ],
        [
          "观测",
          "离线回执不同就记录差异"
        ]
      ],
      "foot": "提取只取字段，断言负责检查正误",
      "cues": [
        {
          "to": 53,
          "text": "试两份完全合成的回执。",
          "file": "2-0.mp3",
          "from": 8
        },
        {
          "to": 113,
          "text": "第一份有约定标题，状态为已归档。",
