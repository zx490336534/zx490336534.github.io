      "artAsset": "scene-02.webp",
      "cues": [
        {
          "to": 90,
          "text": "一页档案里记什么，要从“哪条信息会改变回答”倒推。",
          "file": "1-0.mp3",
          "from": 8
        },
        {
          "to": 245,
          "text": "比如演示人物本周要交一份小教程，只有两段短时间，难的是从已经收集的资料里挑一个清楚例子。",
          "file": "1-1.mp3",
          "from": 92
